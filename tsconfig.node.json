{
  "compilerOptions": {
    "composite": true, // required for project references
    "module": "ESNext",
    "moduleResolution": "bundler", // Vite’s ESM toolchain
    "types": [
      "node", // Node typings for config files
      "vitest/importMeta", // enables import.meta in tests
      "vitest/globals" // if using Vitest globals (describe/it/expect)
    ]
  },
  "include": ["vite.config.ts", "src/test/setup.ts", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
