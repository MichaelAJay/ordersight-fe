{
  "compilerOptions": {
    "composite": true, // needed because root tsconfig references this project
    "jsx": "react-jsx", // React 17+ transform (works with React 19)
    "module": "ESNext",
    "moduleResolution": "bundler", // aligns with Vite/SWC
    "lib": ["ESNext", "DOM", "DOM.Iterable"], // required for Set, Map, and DOM APIs
    "types": ["vite/client"], // Vite env types (import.meta.env.*, etc.)
    "rootDir": "src",
    "outDir": "dist/tsc/app",
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo/tsconfig.app.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
